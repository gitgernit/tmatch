# Server
SERVER_WORKERS=1
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Access token
ACCESS_TOKEN_CRYPTO_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ACCESS_TOKEN_EXPIRES_IN_SECONDS=86400

# Yandex OAuth (пустые, если не используешь)
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# OpenTelemetry
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=app

# Firebase (путь к сертификату для FCM)
FIREBASE_CERTIFICATE_PATH=

# ML
ML_RECOMMENDATION_PROVIDER=mock
ML_BASE_URL=http://127.0.0.1:8081
ML_PHOTO_MODERATION_PROVIDER=mock

# S3 (Yandex Object Storage / совместимое)
S3_ENDPOINT_URL=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
